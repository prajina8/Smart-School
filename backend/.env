PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smart_campus
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Geofencing default campus center + radius (used if a course doesn't override it)
CAMPUS_LAT=27.7000
CAMPUS_LNG=85.3000
CAMPUS_RADIUS_METERS=200

# Rotating QR code refresh interval (seconds) for attendance sessions
QR_ROTATE_SECONDS=20
